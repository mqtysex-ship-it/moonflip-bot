# Discord Bot Token (from Discord Developer Portal)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# Strong unique password for the administration dashboard (username: admin)
DASHBOARD_PASSWORD=replace_with_a_long_random_password

# Stable unique signing key for web sessions; keep private across deployments
WEB_SESSION_SECRET=replace_with_a_long_random_secret

# Supabase PostgreSQL connection string; server certificate verification is required.
DATABASE_URL=postgresql://user:password@host:5432/postgres


# Optional Discord channel for the website's public live-chat bridge
LIVE_CHAT_CHANNEL_ID=1567516974270124172
